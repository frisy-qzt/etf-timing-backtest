include README.md LICENSE CONTRIBUTING.md CHANGELOG.md SECURITY.md
include requirements-backtest.txt
include .editorconfig .gitattributes .gitignore
recursive-include etf_backtest *.py
recursive-include tests *.py
recursive-include scripts *.py
recursive-include examples *.py *.md
recursive-include docs *.md
include data/README.md notebooks/README.md
prune build
prune dist
prune data/research
prune reports
prune output
prune .cache
prune .runtime_deps
global-exclude __pycache__ *.py[cod] .DS_Store

recursive-include examples/data *.parquet *.csv *.json *.md
